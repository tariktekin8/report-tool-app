{
  "name": "@report-tool/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@report-tool/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.5.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
